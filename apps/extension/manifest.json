{
  "manifest_version": 3,
  "name": "MailTrace Webmail Companion",
  "version": "1.0.1",
  "description": "First-party webmail companion for MailTrace tracking telemetry and confirmed views.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "tabs"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.onrender.com/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTrace Companion"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content/page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://outlook.live.com/*", "https://outlook.office.com/*"],
      "js": ["dist/content/outlook.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/content/page-interceptor.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
