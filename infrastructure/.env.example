# MailTrace Environment Configuration
NODE_ENV=production
PORT=3000
APP_DOMAIN=localhost
TRACKING_BASE_URL=http://localhost

# PostgreSQL Database Configuration
POSTGRES_USER=mailtrace
POSTGRES_PASSWORD=mailtrace_secure_password
POSTGRES_DB=mailtrace
DATABASE_URL=postgresql://mailtrace:mailtrace_secure_password@localhost:5432/mailtrace?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cryptography & Security
# 32-byte (64 hex characters) AES-256-GCM encryption key for provider credentials
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Optional Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft Graph OAuth Credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Tracking Domain for Inbound Sub-Addressing
TRACKING_DOMAIN=track.mailtrace.io
