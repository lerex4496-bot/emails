FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat
RUN npm install -g pnpm@11.22.0

FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @mailtrace/shared build
RUN pnpm --filter @mailtrace/database prisma:generate
RUN pnpm --filter @mailtrace/database build
RUN pnpm --filter @mailtrace/tracking build
RUN pnpm --filter @mailtrace/email build
RUN pnpm --filter @mailtrace/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl libc6-compat
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 mailtrace

COPY --from=builder /app /app
USER mailtrace

EXPOSE 3000
CMD ["node", "services/api/dist/server.js"]
